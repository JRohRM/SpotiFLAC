# ── SpotiFLAC server configuration ───────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# Bearer token for API authentication.
# Generate one with: openssl rand -hex 32
API_TOKEN=change_me_to_a_long_random_string

# Host path to your Navidrome music folder.
# This is the directory on the SERVER (not inside the container).
MUSIC_DIR=/path/to/your/navidrome/music

# Path inside the container (should match the volume target above).
OUTPUT_DIR=/music

# Your server's public domain name (used by Traefik).
DOMAIN=your.domain.com

# Traefik cert resolver name (check your Traefik config).
CERT_RESOLVER=letsencrypt

# Port the Go server listens on inside the container (usually no need to change).
# NOTE: published on the wireguard container, since spotiflac shares its netns.
PORT=8080

# ── WireGuard tunnel ──────────────────────────────────────────────────────────
# All SpotiFLAC outbound traffic exits through this tunnel so the download
# providers never rate-limit the host's real IP.
#
# Provide the WHOLE wg0.conf as a single base64 line (no file mount, so it works
# in Coolify). Take your provider's client config and encode it:
#     base64 -w0 wg0.conf          # Linux
#     base64 -i wg0.conf | tr -d '\n'   # macOS
# Paste the result below (or into Coolify's env editor). Keep it secret.
WG_CONFIG_B64=

# User/group + timezone for the wireguard container.
PUID=1000
PGID=1000
TZ=UTC
